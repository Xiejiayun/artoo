# Copy to .env and replace all example values. Never commit .env.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=https://artoo.example.com/auth/google/callback
AUTH_ALLOWED_EMAILS=owner@example.com,teammate@example.com
AUTH_OWNER_EMAILS=owner@example.com
# Optional additional restriction; if set, both domain and email rules apply.
# GOOGLE_HOSTED_DOMAIN=example.com
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARTOO_PAIRING_PEPPER=replace-with-random-generated-secret
ARTOO_DATA_DIR=.artoo
ARTOO_HOST=127.0.0.1
ARTOO_PORT=4000
# For the bundled same-host Caddy proxy only. Leave empty without a proxy.
# Comma-separated explicit proxy IPs; no hostnames, ranges or blanket trust.
ARTOO_TRUSTED_PROXIES=127.0.0.1
# Required for file:// Windows renderer. Never use a wildcard origin.
ARTOO_DESKTOP_CORS=1
ARTOO_DESKTOP_CORS_ORIGINS=null
# Paired control sessions default to 30 days; re-pair after expiry.
ARTOO_CONTROL_TOKEN_TTL_MS=2592000000
