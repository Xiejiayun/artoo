{
  "name": "artoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "demo:v1": "node scripts/v1-demo.mjs",
    "verify:v1": "node scripts/v1-gate.mjs",
    "dev": "npm run dev --workspace @artoo/server",
    "dev:web": "npm run dev --workspace @artoo/web",
    "dev:artood": "npm run dev --workspace @artoo/artood"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
