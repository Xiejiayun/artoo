{
  "name": "artoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:preview": "node scripts/build-preview.mjs",
    "start:preview": "node scripts/start-preview.mjs",
    "storage": "node scripts/storage.mjs",
    "demo:v1": "node scripts/v1-demo.mjs",
    "e2e:auth": "node scripts/auth-e2e.mjs",
    "verify:v1": "node scripts/v1-gate.mjs",
    "verify:preview": "node scripts/preview-gate.mjs",
    "verify:ios": "node scripts/preview-gate.mjs --suite=ios",
    "verify:ios:core": "npm run build:preview && node scripts/ios-ui-suites-e2e.mjs --suite=core",
    "verify:ios:assistant": "npm run build:preview && node scripts/ios-ui-suites-e2e.mjs --suite=assistant",
    "verify:ios:mentions": "npm run build:preview && node scripts/ios-ui-suites-e2e.mjs --suite=mentions",
    "verify:ios:correction": "npm run build:preview && node scripts/ios-ui-suites-e2e.mjs --suite=correction",
    "verify:ios:retention": "npm run build:preview && node scripts/ios-ui-suites-e2e.mjs --suite=retention",
    "verify:mac": "node scripts/preview-gate.mjs --suite=mac",
    "verify:recovery": "npm run build:preview && node --test scripts/recovery-e2e.test.mjs && node scripts/recovery-e2e.mjs",
    "archive:ios:development": "node apps/ios/scripts/archive-device.mjs",
    "archive:ios:distribution": "node apps/ios/scripts/archive-distribution.mjs",
    "verify:ios:release": "node apps/ios/scripts/release-ui.mjs",
    "verify:desktop": "node scripts/preview-gate.mjs --suite=desktop",
    "dev": "npm run dev --workspace @artoo/server",
    "dev:web": "npm run dev --workspace @artoo/web",
    "dev:artood": "npm run dev --workspace @artoo/artood"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
